{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewResult",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "approvalChangeRequestStatus": {
      "type": "string",
      "enum": [
        "approval",
        "change-request"
      ]
    },
    "blockingFindings": {
      "type": "string"
    },
    "nonBlockingFindings": {
      "type": "string"
    },
    "acceptanceCriteriaVerification": {
      "type": "string"
    },
    "testAdequacy": {
      "type": "string"
    },
    "riskObservations": {
      "type": "string"
    },
    "pr": {
      "type": "string"
    },
    "reviewedHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "reviewerIdentity": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "issue",
    "approvalChangeRequestStatus",
    "blockingFindings",
    "nonBlockingFindings",
    "acceptanceCriteriaVerification",
    "testAdequacy",
    "riskObservations",
    "pr",
    "reviewedHeadSha",
    "reviewerIdentity"
  ]
}
