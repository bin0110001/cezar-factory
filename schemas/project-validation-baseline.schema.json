{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectValidationBaselineV1",
  "description": "Reviewed, expiring fingerprints of pre-existing project validation diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "sourceHeadSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "diagnosticFingerprints": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "required": ["schemaVersion", "createdAt", "expiresAt", "sourceHeadSha", "reason", "diagnosticFingerprints"]
}
