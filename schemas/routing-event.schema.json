{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoutingEventV1",
  "description": "One routing decision/execution event (#94). Allow-listed fields only; never carries credentials, tokens or prompt text. runId/attemptId/eventId/traceId are opaque strings owned by #126/#127/#128.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timestamp", "sequence", "attempt", "state"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["queued", "capacity-blocked", "routed", "running", "rate-limited", "retried", "completed", "failed", "cancelled"] },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "maxLength": 128 },
        "tier": { "type": "string", "maxLength": 64 },
        "subscriptionAlias": { "type": "string", "maxLength": 128 }
      }
    },
    "decisionReason": { "type": "string", "maxLength": 512 },
    "deferralReason": { "type": "string", "maxLength": 512 },
    "fallback": { "type": "boolean" },
    "forecastConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "quotaSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "number", "minimum": 0 },
        "used": { "type": "number", "minimum": 0 },
        "remaining": { "type": "number", "minimum": 0 },
        "ratio": { "type": "number", "minimum": 0 },
        "resetAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
