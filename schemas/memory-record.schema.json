{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://factory.local/schemas/memory-record.schema.json",
  "type":"object",
  "required":["id","project","topic","lesson","kind","scope","claimType","validationStatus","evidenceLinks","version","contentHash","retainedAt","superseded","versionHistory"],
  "properties":{
    "id":{"type":"string","minLength":1},"project":{"type":"string","minLength":1},
    "topic":{"type":"string","minLength":3,"maxLength":160},"lesson":{"type":"string","minLength":10,"maxLength":2000},
    "kind":{"enum":["architecture","recurring-failure","successful-fix","convention","environment-discovery"]},
    "scope":{"enum":["repo","global"]},"claimType":{"enum":["fact","hypothesis"]},
    "validationStatus":{"enum":["validated","unvalidated"]},"evidenceLinks":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","required":["kind","ref","validationStatus"],"properties":{"kind":{"enum":["run","issue","commit","test","file"]},"ref":{"type":"string","minLength":1,"maxLength":2048},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"validationStatus":{"enum":["validated","unvalidated"]}},"additionalProperties":false}},
    "version":{"type":"integer","minimum":1},"contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"retainedAt":{"type":"string","format":"date-time"},
    "superseded":{"type":"boolean"},"supersedes":{"type":["string","null"]},"supersededBy":{"type":["string","null"]},"supersededAt":{"type":"string","format":"date-time"},
    "versionHistory":{"type":"array","maxItems":32,"items":{"type":"object","required":["id","version","contentHash","retainedAt"],"properties":{"id":{"type":"string"},"version":{"type":"integer","minimum":1},"contentHash":{"type":"string"},"retainedAt":{"type":"string"}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
