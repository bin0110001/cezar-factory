{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://factory.local/schemas/memory-retrieval-capture.schema.json",
  "type":"object","required":["schemaVersion","project","readAt","deterministicMatches","memories"],
  "properties":{
    "schemaVersion":{"const":1},"project":{"type":"string","minLength":1},"readAt":{"type":"string","format":"date-time"},
    "deterministicMatches":{"type":"array","maxItems":100,"items":{"type":"object","required":["kind","id","ref","contentHash"],"properties":{"kind":{"enum":["fingerprint","test"]},"id":{"type":"string"},"ref":{"type":"string"},"contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},
    "memories":{"type":"array","maxItems":8,"items":{"type":"object","required":["id","version","contentHash","readAt","validationStatus"],"properties":{"id":{"type":"string"},"version":{"type":["integer","null"],"minimum":1},"contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"readAt":{"type":"string","format":"date-time"},"validationStatus":{"enum":["validated","unvalidated","superseded"]}},"additionalProperties":false}}
  },"additionalProperties":false
}
