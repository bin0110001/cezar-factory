{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImplementationResult",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "summary": {
      "type": "string"
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testsRun": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testResult": {
      "type": "string"
    },
    "acceptanceCriteriaStatus": {
      "type": "string"
    },
    "documentationUpdated": {
      "type": "boolean"
    },
    "knownConcerns": {
      "type": "string"
    },
    "followUpSuggestions": {
      "type": "string"
    },
    "durableKnowledgeCandidates": {
      "type": "string"
    },
    "pr": {
      "type": "string"
    }
  },
  "required": [
    "issue",
    "status",
    "summary",
    "filesChanged",
    "testsRun",
    "testResult",
    "acceptanceCriteriaStatus",
    "knownConcerns",
    "followUpSuggestions",
    "durableKnowledgeCandidates",
    "documentationUpdated"
  ]
}
