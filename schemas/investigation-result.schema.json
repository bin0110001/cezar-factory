{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvestigationResult",
  "type": "object",
  "properties": {
    "failureClassification": { "type": "string" },
    "evidence": { "type": "string" },
    "attemptsReviewed": { "type": "string" },
    "rootCauseHypothesis": { "type": "string" },
    "confidence": { "type": "string" },
    "recommendedAction": { "type": "string" },
    "automaticRetryAppropriate": { "type": "boolean" }
  },
  "required": [
    "failureClassification",
    "evidence",
    "attemptsReviewed",
    "rootCauseHypothesis",
    "confidence",
    "recommendedAction",
    "automaticRetryAppropriate"
  ]
}
