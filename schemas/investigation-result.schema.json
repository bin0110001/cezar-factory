{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvestigationResult",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "failureClassification": {
      "type": "string",
      "enum": [
        "implementation", "test", "flaky-test", "environment", "dependency",
        "merge-conflict", "requirements", "architecture", "unknown"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "attemptsReviewed": {
      "type": "string"
    },
    "rootCauseHypothesis": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "recommendedAction": {
      "type": "string"
    },
    "automaticRetryAppropriate": {
      "type": "boolean"
    }
  },
  "required": [
    "issue",
    "failureClassification",
    "evidence",
    "attemptsReviewed",
    "rootCauseHypothesis",
    "confidence",
    "recommendedAction",
    "automaticRetryAppropriate"
  ]
}
