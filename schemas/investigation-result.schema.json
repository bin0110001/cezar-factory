{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvestigationResult",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "failureClassification": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "attemptsReviewed": {
      "type": "string"
    },
    "rootCauseHypothesis": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "recommendedAction": {
      "type": "string"
    },
    "automaticRetryAppropriate": {
      "type": "boolean"
    },
    "decisions": {
      "type": "array",
      "description": "Optional structured decision requests (schemas/decision.schema.json). Provide them whenever the result asks the user to decide something; keep unresolvedQuestions as the readable summary.",
      "items": { "type": "object" }
    }
  },
  "required": [
    "issue",
    "failureClassification",
    "evidence",
    "attemptsReviewed",
    "rootCauseHypothesis",
    "confidence",
    "recommendedAction",
    "automaticRetryAppropriate"
  ]
}
