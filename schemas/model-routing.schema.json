{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelRoutingConfigV1",
  "description": "Capability tiers and provider model families (#92). Tier membership is explicit; models are never assumed equivalent.",
  "type": "object",
  "required": ["schemaVersion", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "models": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["provider", "modelId"], "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "modelId": {"type": "string", "minLength": 1},
        "features": {"type": "object", "additionalProperties": false, "properties": {
          "tools": {"type": "boolean"}, "multimodal": {"type": "boolean"},
          "contextTokens": {"type": "number", "minimum": 0}, "coding": {"type": "number", "minimum": 0},
          "reasoning": {"type": "number", "minimum": 0}, "quality": {"type": "number", "minimum": 0},
          "locality": {"enum": ["local", "remote"]}}}
      }}},
    "tiers": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["candidates"], "additionalProperties": false,
      "properties": {
        "require": {"type": "object", "additionalProperties": false, "properties": {
          "tools": {"type": "boolean"}, "multimodal": {"type": "boolean"}, "minContextTokens": {"type": "number"},
          "minCoding": {"type": "number"}, "minReasoning": {"type": "number"}, "locality": {"enum": ["local", "remote"]}}},
        "minQuality": {"type": "number"},
        "candidates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "providerAllow": {"type": "array", "items": {"type": "string"}},
        "providerDeny": {"type": "array", "items": {"type": "string"}},
        "accountAffinity": {"type": "array", "items": {"type": "string"}},
        "fallback": {"enum": ["allow", "none"]}
      }}}
  }
}
