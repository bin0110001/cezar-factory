{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactoryConfig",
  "type": "object",
  "properties": {
    "factory": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["source", "version"],
      "additionalProperties": false
    },
    "workflows": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "features": {
      "type": "object",
      "properties": {
        "knowledge_extraction": { "type": "boolean" },
        "maintenance": { "type": "boolean" },
        "backlog_reconciliation": { "type": "boolean" },
        "backlog_label_cleanup": { "type": "boolean" },
        "godot_upgrade": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "type": { "type": "string" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "godot": {
      "type": "object",
      "properties": {
        "testCommand": { "type": "string" },
        "testRegressionExitCodes": { "type": "array", "items": { "type": "integer" } }
      },
      "required": ["testCommand", "testRegressionExitCodes"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["cezar", "local"] },
        "record": { "type": "string" }
      },
      "required": ["provider", "record"],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "quick": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/validationCommand" }] },
        "targeted": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/validationCommand" }] },
        "changed": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/validationCommand" }] },
        "full": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/validationCommand" }] },
        "verify": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/validationCommand" }] }
      },
      "required": ["full", "verify"],
      "anyOf": [{ "required": ["changed"] }, { "required": ["targeted"] }],
      "additionalProperties": false
    }
  },
  "required": ["factory", "workflows", "skills", "features", "project", "validation"],
  "additionalProperties": false,
  "$defs": {
    "validationCommand": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "resultFormat": { "type": "string", "enum": ["json", "exit-code"] },
        "workingDirectory": { "type": "string" },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "evidencePath": { "type": "string" },
        "baselinePath": { "type": "string" },
        "baselineSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "appliesTo": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["command", "workingDirectory", "prerequisites", "timeoutSeconds", "evidencePath", "appliesTo"],
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": { "properties": { "project": { "properties": { "type": { "const": "godot" } } } } },
    "then": {
      "properties": {
        "godot": {
          "type": "object",
          "properties": {
            "testCommand": { "type": "string" },
            "testRegressionExitCodes": { "type": "array", "items": { "type": "integer" } }
          },
          "required": ["testCommand", "testRegressionExitCodes"],
          "additionalProperties": false
        }
      },
      "required": ["godot"]
    }
  }]
}
