{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowValidationReceiptV1",
  "description": "A workflow-command-produced, head-bound validation receipt. Agent result JSON is never a substitute for this record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "issue": { "type": "integer", "minimum": 1 },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "pr": { "type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[1-9][0-9]*$" },
    "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "stage": { "type": "string", "enum": ["changed", "full", "verify"] },
    "status": { "type": "string", "enum": ["passed", "failed", "skipped", "unavailable", "no-matching-tests", "error"] },
    "exitCode": { "type": "integer" },
    "reasonCode": { "type": "string", "enum": ["validation_passed", "validation_command_failed", "validation_command_missing", "validation_config_missing", "validation_config_invalid", "validation_working_directory_missing", "validation_prerequisite_missing", "validation_applicability_rules_missing", "validation_change_set_too_large", "validation_not_applicable", "validation_no_applicable_changes", "targeted_validation_unsupported", "issue_already_resolved", "validation_result_passed", "validation_result_failed", "validation_result_skipped", "validation_result_unavailable", "validation_result_no_matching_tests", "validation_result_malformed", "validation_result_contradicts_exit_code", "validation_error", "validation_infrastructure_error", "validation_head_changed"] },
    "artifactPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "worktreeClean": { "type": "boolean" },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "command": { "type": "string" },
    "workingDirectory": { "type": "string" },
    "evidencePath": { "type": "string" },
    "changedFiles": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 4096 } },
    "changedFilesKnown": { "type": "boolean" },
    "validationResult": {
      "type": ["object", "null"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped", "unavailable", "no-matching-tests"] },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "message": { "type": "string", "maxLength": 2000 },
        "matchedTests": { "type": "integer", "minimum": 0 },
        "passedTests": { "type": "integer", "minimum": 0 },
        "failedTests": { "type": "integer", "minimum": 0 },
        "skippedTests": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 2000 } }
      },
      "required": ["schemaVersion", "status", "reasonCode"],
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] }, "then": { "properties": { "failedTests": { "maximum": 0 } } } },
        { "if": { "properties": { "status": { "const": "no-matching-tests" } }, "required": ["status"] }, "then": { "properties": { "matchedTests": { "maximum": 0 } } } }
      ]
    },
    "diagnosticComparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["unconfigured", "compared", "unavailable"] },
        "reasonCode": { "type": "string", "enum": ["baseline_not_configured", "baseline_config_invalid", "baseline_path_invalid", "baseline_hash_mismatch", "baseline_provenance_invalid", "baseline_compared"] },
        "baselineSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "knownFingerprints": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "newFingerprints": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "unclassifiedCount": { "type": "integer", "minimum": 0 }
      },
      "required": ["status", "reasonCode", "baselineSha256", "knownFingerprints", "newFingerprints", "unclassifiedCount"]
    },
    "truncated": { "type": "boolean" },
    "message": { "type": "string" }
  },
  "required": ["schemaVersion", "issue", "repository", "pr", "headSha", "stage", "status", "exitCode", "artifactPaths"]
}
