{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowValidationReceiptV1",
  "description": "A workflow-command-produced, head-bound validation receipt. Agent result JSON is never a substitute for this record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "issue": { "type": "integer", "minimum": 1 },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "pr": { "type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[1-9][0-9]*$" },
    "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "stage": { "type": "string", "enum": ["changed", "full", "verify"] },
    "status": { "type": "string", "enum": ["passed", "failed", "skipped", "unavailable", "error"] },
    "exitCode": { "type": "integer" },
    "reasonCode": { "type": "string", "enum": ["validation_passed", "validation_command_failed", "validation_command_missing", "validation_config_missing", "validation_config_invalid", "validation_working_directory_missing", "validation_prerequisite_missing", "targeted_validation_unsupported", "issue_already_resolved", "validation_error", "validation_infrastructure_error", "validation_head_changed"] },
    "artifactPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "worktreeClean": { "type": "boolean" },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "command": { "type": "string" },
    "workingDirectory": { "type": "string" },
    "evidencePath": { "type": "string" },
    "truncated": { "type": "boolean" },
    "message": { "type": "string" }
  },
  "required": ["schemaVersion", "issue", "repository", "pr", "headSha", "stage", "status", "exitCode", "artifactPaths"]
}
