{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanningResult",
  "type": "object",
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "string",
      "minLength": 1
    },
    "nonGoals": {
      "type": "string"
    },
    "risks": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "suggestedWorkBreakdown": {
      "type": "string"
    },
    "requiredProjectSkills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolvedQuestions": {
      "type": "string"
    },
    "complexity": {
      "type": "string",
      "enum": ["complexity:small", "complexity:medium", "complexity:large"]
    },
    "readyNotReadyStatus": {
      "type": "string",
      "enum": [
        "ready",
        "not-ready",
        "decomposed"
      ]
    },
    "memoryRecall": {
      "type": "object",
      "properties": {
        "banksQueried": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memoryIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memoryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "contextChars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        }
      },
      "required": ["banksQueried", "memoryCount"]
    },
    "subIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "complexity": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "title",
          "body",
          "type",
          "risk",
          "complexity"
        ]
      }
    }
  },
  "required": [
    "issue",
    "objective",
    "acceptanceCriteria",
    "nonGoals",
    "risks",
    "dependencies",
    "suggestedWorkBreakdown",
    "requiredProjectSkills",
    "unresolvedQuestions",
    "complexity",
    "readyNotReadyStatus"
  ]
}
