{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepairPolicyV1",
  "description": "Layered repair-authorization policy (#740). Overrides may only tighten limits and can never weaken governance.",
  "type": "object",
  "required": ["schemaVersion", "version", "limits", "governance"],
  "additionalProperties": false,
  "definitions": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRepairRounds": {"type": "integer", "minimum": 0},
        "unchangedFindingPersistence": {"type": "integer", "minimum": 1},
        "consecutiveNoProgress": {"type": "integer", "minimum": 1},
        "oscillationLimit": {"type": "integer", "minimum": 1},
        "replanAfterUnchanged": {"type": "integer", "minimum": 1},
        "maxReplans": {"type": "integer", "minimum": 0},
        "infraRetryBudget": {"type": "integer", "minimum": 0},
        "maxSeconds": {"type": ["number", "null"], "minimum": 0},
        "maxTokens": {"type": ["number", "null"], "minimum": 0},
        "maxCostUsd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stopOnSafetyViolation": {"type": "boolean"},
        "stopOnSecurityIssue": {"type": "boolean"},
        "enforceRequiredGates": {"type": "boolean"},
        "incompleteNeverSuccess": {"type": "boolean"},
        "allowIndependentDiagnosis": {"type": "boolean"}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {"$ref": "#/definitions/limits"},
        "governance": {"$ref": "#/definitions/governance"}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "limits": {"$ref": "#/definitions/limits"},
    "governance": {"$ref": "#/definitions/governance"},
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/definitions/layer"},
        "workflows": {"type": "object", "additionalProperties": {"$ref": "#/definitions/layer"}},
        "validators": {"type": "object", "additionalProperties": {"$ref": "#/definitions/layer"}}
      }
    }
  }
}
