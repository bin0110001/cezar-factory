{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactoryLocalPromotionRecordV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "factory-local-promotion-record/v1" },
    "promotionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "branch": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["healthy", "failed"] },
    "candidateState": { "enum": ["unvalidated", "validated", "staged", "active", "rolled-back"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "changedPaths": { "type": "array", "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "checks": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "required", "status", "startedAt", "finishedAt", "durationMs", "outputPreview", "outputTruncated", "outputDigest"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "required": { "type": "boolean" },
          "status": { "enum": ["passed", "failed", "preexisting-debt"] },
          "exitCode": { "type": ["integer", "null"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "outputPreview": { "type": "string", "maxLength": 131072 },
          "outputTruncated": { "type": "boolean" },
          "outputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "failureLines": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 200 } },
          "nonblockingExistingFailures": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "activation": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" }, "activationId": { "type": ["string", "null"] }, "targetCount": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
      ]
    },
    "canaries": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "automation", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "automation": { "type": "string", "minLength": 1, "maxLength": 256 },
          "status": { "enum": ["passed", "failed"] },
          "runId": { "type": "string" },
          "runStatus": { "type": "string" },
          "reason": { "type": "string", "maxLength": 1000 },
          "startedAt": { "type": "string" },
          "finishedAt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rollback": { "type": "string", "maxLength": 1000 },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reason": { "type": ["string", "null"], "maxLength": 2000 },
    "recordDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "required": ["schemaVersion", "promotionId", "sourceSha", "branch", "status", "candidateState", "startedAt", "finishedAt", "changedPaths", "checks", "activation", "recordDigest"]
}
