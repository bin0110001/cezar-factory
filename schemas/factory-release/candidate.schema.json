{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactoryReleaseCandidateV1",
  "description": "Durable record of the single nonterminal release candidate of a project (scripts/release/factory_candidate_state.py).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 256 },
    "state": { "enum": ["requested", "admitted", "snapshotting", "validating", "repair-required", "revalidating", "ready", "awaiting-approval", "promoting", "activating", "promoted", "abandoned", "failed", "canceled"] },
    "source_dev_sha": { "type": "string", "minLength": 1 },
    "base_stable_sha": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "candidate_sha": { "type": ["string", "null"] },
    "config_hash": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "lock_owner": { "type": ["string", "null"] },
    "lease_expires": { "type": ["number", "null"] },
    "fencing_token": { "type": "integer", "minimum": 0 },
    "pending_triggers": { "type": "array", "items": { "type": "string" } },
    "test_run_ids": { "type": "array", "items": { "type": "string" } },
    "receipts": { "type": "object" }
  },
  "required": ["id", "project", "state", "source_dev_sha", "base_stable_sha", "revision", "config_hash", "created_at", "updated_at", "fencing_token"]
}
