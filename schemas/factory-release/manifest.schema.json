{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactoryReleaseManifestV1",
  "description": "Immutable identity and compatibility facts for one built Factory artifact. manifestDigest is RFC 8785 JCS SHA-256 over the object with manifestDigest omitted.",
  "$comment": "Consumers also enforce ordinally sorted unique file paths, source SHA length matching gitObjectFormat, actual artifact/file/evidence digests, and safe archive path containment. The Cezar Zod contract implements these semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "factory-release-manifest/v1" },
    "source": { "$ref": "#/$defs/source" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "files": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } },
    "build": { "$ref": "#/$defs/build" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "verification": { "$ref": "#/$defs/verification" },
    "manifestDigest": { "$ref": "#/$defs/sha256" }
  },
  "required": ["schemaVersion", "source", "artifact", "files", "build", "compatibility", "verification", "manifestDigest"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$)).+$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "sha": { "$ref": "#/$defs/gitSha" },
        "gitObjectFormat": { "type": "string", "enum": ["sha1", "sha256"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["repository", "sha", "gitObjectFormat", "ref"],
      "allOf": [
        { "if": { "properties": { "gitObjectFormat": { "const": "sha1" } }, "required": ["gitObjectFormat"] }, "then": { "properties": { "sha": { "pattern": "^[a-f0-9]{40}$" } } } },
        { "if": { "properties": { "gitObjectFormat": { "const": "sha256" } }, "required": ["gitObjectFormat"] }, "then": { "properties": { "sha": { "pattern": "^[a-f0-9]{64}$" } } } }
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "properties": { "format": { "type": "string", "enum": ["tar", "directory"] }, "byteSize": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } },
      "required": ["format", "byteSize", "sha256"]
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "properties": { "path": { "$ref": "#/$defs/relativePath" }, "byteSize": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } },
      "required": ["path", "byteSize", "sha256"]
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "builder": { "type": "string", "minLength": 1, "maxLength": 128 }, "builderVersion": { "type": "string", "minLength": 1, "maxLength": 128 }, "workflow": { "type": "string", "minLength": 1, "maxLength": 128 }, "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" } },
      "required": ["id", "builder", "builderVersion", "workflow", "startedAt", "completedAt"]
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": { "cezarApi": { "type": "string", "minLength": 1, "maxLength": 256 }, "requiredCapabilities": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } } },
      "required": ["cezarApi", "requiredCapabilities"]
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "description": "Reference only; the full result schema is owned by #49 and validation adapters by #19.",
      "properties": { "resultVersion": { "type": "integer", "const": 1 }, "status": { "type": "string", "const": "passed" }, "digest": { "$ref": "#/$defs/sha256" }, "evidenceRef": { "$ref": "#/$defs/relativePath" } },
      "required": ["resultVersion", "status", "digest", "evidenceRef"]
    }
  }
}
