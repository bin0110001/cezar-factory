{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Godot verification provider manifest (extends check-provider.schema.json provider identity)",
  "type": "object",
  "required": ["version", "provider", "capabilities", "compatibility", "install", "provenance", "workerProfile", "environmentHash"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "provider": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "enum": ["parse", "startup", "gdunit", "scene-resource-refs", "render", "network-scenario", "gua"] }
    },
    "compatibility": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": { "$ref": "#/$defs/versionRange" },
        "gdunit": { "$ref": "#/$defs/versionRange" }
      }
    },
    "install": {
      "type": "object",
      "required": ["discovery"],
      "additionalProperties": false,
      "properties": {
        "discovery": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "enum": ["env:GODOT_BIN", "path", "cezar/godot-select.sh", "project-pinned"] } },
        "installer": { "type": "string", "maxLength": 256 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["tools"],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "required": ["name", "version"], "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "version": { "type": "string", "minLength": 1, "maxLength": 64 },
              "source": { "type": "string", "maxLength": 256 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "workerProfile": {
      "type": "object",
      "required": ["renderer", "display"],
      "additionalProperties": false,
      "properties": {
        "renderer": { "enum": ["none", "software", "gpu"] },
        "display": { "enum": ["headless", "virtual", "physical"] },
        "os": { "type": "array", "uniqueItems": true, "items": { "enum": ["linux", "windows", "macos"] } },
        "capabilities": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } }
      }
    },
    "assetMounts": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "required": ["name"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "environmentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "versionRange": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "min": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" },
        "max": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" }
      }
    }
  }
}
