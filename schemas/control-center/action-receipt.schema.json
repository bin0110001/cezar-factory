{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cezar-factory.local/schemas/control-center/action-receipt.schema.json",
  "title": "Factory Control Center action receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "idempotencyKey", "status", "submittedAt", "completedAt"],
  "properties": {
    "schemaVersion": { "const": "factory-control-center-action-receipt/v1" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
    "action": { "enum": ["sync", "stage", "rollback", "verify", "protect", "unprotect"] },
    "channel": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "status": { "enum": ["succeeded", "failed", "running", "interrupted"] },
    "actorId": { "type": "string", "maxLength": 64 },
    "submittedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "reason": { "type": "string", "maxLength": 500 },
    "result": { "type": ["object", "null"] },
    "message": { "type": ["string", "null"], "maxLength": 2000 },
    "replayed": { "type": "boolean" }
  }
}
