{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cezar-factory.local/schemas/control-center/access-config.schema.json",
  "title": "Factory Control Center local token access config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tokens"],
  "properties": {
    "schemaVersion": { "const": "factory-control-center-access/v1" },
    "tokens": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tokenId", "tokenSha256", "roles"],
        "properties": {
          "tokenId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "tokenSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["viewer", "operator", "release-admin"] } }
        }
      }
    }
  }
}
