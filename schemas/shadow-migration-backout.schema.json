{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shadow migration backout record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseSha": { "type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$" },
    "branch": { "type": "string", "pattern": "^codex/migrate-factory-[a-z0-9-]+-[a-f0-9]{8}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "removedFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^\\.ai/", "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "sourcePath": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "required": ["path", "sha256", "sourcePath"]
      }
    },
    "restoreCommand": { "type": "string", "minLength": 1, "maxLength": 20000 }
  },
  "required": ["schemaVersion", "projectId", "baseSha", "branch", "createdAt", "removedFiles", "restoreCommand"]
}
