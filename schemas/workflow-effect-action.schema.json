{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowEffectActionV1",
  "description": "A normalized, revision-bound proposed effect. Consumers re-check authorization and current state before applying one of the explicitly allowlisted operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "expectedRevision",
    "operation",
    "arguments",
    "rationale",
    "operationKey"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "id": { "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "type": "string", "minLength": 1, "maxLength": 256 }
        ] }
      }
    },
    "expectedRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": {
      "type": "string",
      "enum": [
        "github.issue.update_labels",
        "github.issue.refresh_lifecycle",
        "github.issue.add_comment",
        "github.issue.close",
        "github.issue.create_child",
        "pull_request.closing_reference.ensure",
        "github.pull_request.create",
        "github.pull_request.enable_auto_merge"
      ]
    },
    "arguments": { "type": "object", "minProperties": 1 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
    "operationKey": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
