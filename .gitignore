# Cezar runtime and operational state
.ai/cezar/
.ai/cezer/
.agents/

# Test artifacts
tests/fixtures/*/artifacts/
.artifacts/

# Temporary files
*.tmp
*.bak
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]

# Local script output
scripts/artifacts/
scripts/update.log

# Deployment secrets and host-local state
integrations/**/.env
integrations/**/.env.*
!integrations/**/env.example
integrations/**/cache/

# Installation-specific server inventory (SSH aliases, addresses, service placement)
config/server-topology.env
config/factory-projects.json
config/failure-repair.json
integrations/bazzite/prometheus-model-targets.generated.json
integrations/bazzite/prometheus-vllm-token.generated


connections/**/*

# Local ship-loop attempt state
.factory/ship-loop/

# Local worktrees and per-issue checkouts under .factory are never tracked (embedded repos break deploy parity)
.factory/autonomous-backlog-lifecycle
.factory/issue-*
.factory/target-*
.factory/worktrees/

# Workflow scratch written into every run worktree; an agent's `git add -A` must not commit it into the PR
.factory/artifacts/
.factory/implement-result.json
.factory/implementation-context.json
.factory/model-probe.json
.factory/fix-result.json
.factory/review-result.json
.factory/plan-result.json
.factory/investigation-result.json

# More workflow scratch (written by command steps, committed by accident via `git add -A` in the past).
# Only .factory/release-reports/ and .factory/obot-caddy-root.crt are intentionally tracked.
.factory/audit-reservation-recovery.json
.factory/backlog-label-audit*.json
.factory/execution.json
.factory/intake-issue.json
.factory/intake-result.json
.factory/repository-maintenance.json
.factory/stale-workable-refresh.json
.factory/startup/
.factory/sync-issue-delivery.json
.factory/repair-latest-failure/

# Everything under .factory/ is run scratch except what is deliberately tracked. Cezar's end-of-run
# autosave commits whatever is not ignored (this once put gh-cache entries, then a scratch audit file,
# into a `cez/<id>` branch every hour), so a new scratch file must be ignored by default, not by name.
.factory/*
!.factory/release-reports/
!.factory/obot-caddy-root.crt
.factory/release-reports/shadow-audit.json