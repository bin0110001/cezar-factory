#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
for git_env in $(git rev-parse --local-env-vars); do
  unset "$git_env"
done
cd "$repo_root"

if ! command -v pwsh >/dev/null 2>&1; then
  echo "pre-commit: PowerShell 7 (pwsh) is required to run the Factory tests." >&2
  exit 1
fi
if ! command -v yamllint >/dev/null 2>&1; then
  echo "pre-commit: install yamllint 1.37.1; see docs/local-validation.md." >&2
  exit 1
fi

pwsh -NoProfile -File tests/run-tests.ps1
yamllint -c .yamllint.yaml .yamllint.yaml workflows automations routing policies templates
