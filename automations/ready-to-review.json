{
  "name": "[factory] ready-to-review",
  "description": "Review issues that gain factory:review (managed by cezar-factory; do not edit in the cockpit)",
  "kind": "github",
  "events": [
    "issue.labeled"
  ],
  "intervalSeconds": 300,
  "filters": {
    "changedLabels": [
      "factory:review"
    ],
    "allLabels": [
      "factory:review"
    ],
    "excludeLabels": [
      "factory:blocked"
    ],
    "maxRecords": 25,
    "lookbackDays": 30,
    "maxAdmissionsPerCycle": 1,
    "fullReconcileHours": 24,
    "initialSync": "eligible"
  },
  "task": {
    "prompt": "GitHub issue #{{github.number}} ({{github.title}}) at {{github.url}}",
    "workflow": "factory-review",
    "runner": "claude",
    "model": "sonnet",
    "worktree": true,
    "autonomous": true
  }
}
