{
  "name": "[factory] ready-to-implement-large",
  "description": "Implement large ready issues with Sol (managed by cezar-factory; do not edit in the cockpit)",
  "kind": "github",
  "events": [
    "issue.labeled"
  ],
  "intervalSeconds": 300,
  "filters": {
    "changedLabels": [
      "factory:ready"
    ],
    "allLabels": [
      "factory:ready",
      "complexity:large"
    ],
    "excludeLabels": [
      "factory:working",
      "factory:blocked",
      "factory:needs-help"
    ],
    "maxRecords": 25,
    "lookbackDays": 30,
    "maxAdmissionsPerCycle": 1,
    "fullReconcileHours": 24
  },
  "task": {
    "prompt": "GitHub issue #{{github.number}} ({{github.title}}) at {{github.url}}",
    "workflow": "factory-implement",
    "runner": "claude",
    "model": "sonnet",
    "worktree": true,
    "autonomous": true
  }
}
