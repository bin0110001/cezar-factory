{
  "name": "[factory] intake",
  "description": "Classify newly opened Factory issues and send them to planning (managed by cezar-factory; do not edit in the cockpit)",
  "kind": "github",
  "events": ["issue.opened", "issue.labeled"],
  "intervalSeconds": 300,
  "filters": {
    "changedLabels": ["factory:new"],
    "allLabels": ["factory:new"],
    "excludeLabels": ["factory:blocked", "factory:needs-plan", "factory:working", "factory:needs-help", "factory:tracking", "epic"],
    "lookbackDays": 30,
    "maxRecords": 25,
    "maxAdmissionsPerCycle": 1,
    "fullReconcileHours": 24,
    "initialSync": "eligible"
  },
  "task": {
    "prompt": "GitHub issue #{{github.number}} ({{github.title}}) at {{github.url}}",
    "workflow": "factory-intake",
    "runner": "claude",
    "model": "sonnet",
    "worktree": true,
    "autonomous": true
  }
}
