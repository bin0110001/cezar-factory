{
  "name": "[factory] ready-to-implement",
  "description": "Implement issues that gain factory:ready (managed by cezar-factory; do not edit in the cockpit)",
  "kind": "github",
  "events": [
    "issue.labeled"
  ],
  "intervalSeconds": 300,
  "filters": {
    "changedLabels": [
      "factory:ready"
    ],
    "allLabels": [
      "factory:ready"
    ],
    "excludeLabels": [
      "factory:working",
      "factory:blocked",
      "factory:needs-help"
    ],
    "maxRecords": 1
  },
  "task": {
    "prompt": "GitHub issue #{{github.number}} ({{github.title}}) at {{github.url}}",
    "workflow": "factory-implement",
    "runner": "codex",
    "model": "gpt-5.6-terra",
    "worktree": true,
    "autonomous": true
  }
}
