{
  "schemaVersion": 1,
  "description": "Verification governance assets an implementation or repair diff must not change without an authorized review marker (see docs/governance-guard.md).",
  "waiverLedger": ".factory/ledger/governance-waivers.jsonl",
  "assets": [
    { "category": "policy", "globs": ["policies/**", "config/promotion-policy.json", "config/release-pipeline*.json"] },
    { "category": "baseline", "globs": ["**/baselines/**", "**/*.baseline", "**/*.baseline.*", "**/*-baseline.*"] },
    { "category": "check-selection", "globs": [".ai/factory/test-ownership.json"], "semantic": "mandatory-checks" },
    { "category": "ledger-evidence", "globs": [".factory/ledger/**", ".factory/verification/**", ".factory/repair-ledger*", ".factory/evaluations/**", ".factory/artifacts/validation/**", ".factory/ship-loop/receipts/**", ".factory/release-reports/**", "ledger/**", "evidence/**"], "appendOnly": true },
    { "category": "evidence-schema", "globs": ["schemas/evidence-manifest.schema.json", "schemas/validation-receipt.schema.json", "schemas/governance-authorization.schema.json"] },
    { "category": "guard", "globs": ["scripts/factory/protect-governance.ps1", "workflows/implement.yaml", "workflows/fix-review.yaml"] }
  ]
}
