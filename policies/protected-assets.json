{
  "schemaVersion": 1,
  "description": "Verification governance assets an implementation or repair diff must not change without an authorized review marker (see docs/governance-guard.md).",
  "waiverLedger": ".factory/ledger/governance-waivers.jsonl",
  "assets": [
    { "category": "policy", "globs": ["policies/**", "config/promotion-policy.json"] },
    { "category": "baseline", "globs": ["**/baselines/**", "**/*.baseline", "**/*.baseline.*", "**/*-baseline.*"] },
    { "category": "check-selection", "globs": [".ai/factory/test-ownership.json"], "semantic": "mandatory-checks" },
    { "category": "ledger-evidence", "globs": [".factory/ledger/**", "ledger/**", "evidence/**"], "appendOnly": true },
    { "category": "guard", "globs": ["scripts/factory/protect-governance.ps1", "workflows/implement.yaml", "workflows/fix-review.yaml"] }
  ]
}
