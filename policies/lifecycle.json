{
  "schemaVersion": "factory-lifecycle/v1",
  "description": "The Factory issue lifecycle as data. A profile lists every state with its owner, legal exits, and deadline. Scripts and automations are being moved to read this file instead of their own label lists (STABILIZATION-PLAN.md, item 1.4). refresh-stale-workable.ps1 re-triggers states whose onTimeout is retrigger; sweep-lifecycle.ps1 applies requires.otherwise, onUnblocked and onConflict and reports every issue past its deadline.",
  "defaultProfile": "standard",
  "markers": {
    "factory:tracking": "An epic or tracking parent. Not executable work; no state is required.",
    "factory:interactive": "Work done in a local dev window. Stale-work sweeps skip it.",
    "factory:auditing": "A temporary reservation by the backlog label audit. Released on expiry."
  },
  "profiles": {
    "standard": {
      "description": "The current process: intake, plan, implement, review, merge. People decide only unresolved major architectural questions.",
      "initial": "factory:new",
      "states": {
        "factory:new": {
          "kind": "automated",
          "lane": "Inbox",
          "owner": { "workflow": "factory-intake" },
          "exits": [
            { "to": "factory:needs-plan", "on": "intake-result", "outcome": "classified" },
            { "to": "factory:needs-help", "on": "intake-result", "outcome": "question" },
            { "to": "factory:ready", "on": "plan-result", "outcome": "ready" },
            { "to": "factory:needs-help", "on": "plan-result", "outcome": "not-ready" },
            { "to": "factory:done", "on": "plan-result", "outcome": "decomposed" }
          ],
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:needs-plan": {
          "kind": "automated",
          "lane": "Refinement",
          "owner": { "workflow": "factory-plan" },
          "exits": [
            { "to": "factory:ready", "on": "plan-result", "outcome": "ready" },
            { "to": "factory:needs-help", "on": "plan-result", "outcome": "not-ready" },
            { "to": "factory:done", "on": "plan-result", "outcome": "decomposed" }
          ],
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:ready": {
          "kind": "automated",
          "lane": "Ready",
          "owner": { "workflow": "factory-implement" },
          "requires": { "exactlyOne": "complexity", "otherwise": "factory:needs-plan" },
          "exits": [
            { "to": "factory:working", "on": "start", "outcome": "started" },
            { "to": "factory:needs-plan", "on": "lifecycle-sweep" }
          ],
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:working": {
          "kind": "in-run",
          "lane": "Active",
          "owner": { "workflows": ["factory-implement", "factory-fix-review"] },
          "exits": [
            { "to": "factory:review", "on": "implement-result", "outcome": "success" },
            { "to": "factory:investigate", "on": "implement-result", "outcome": "failed" },
            { "to": "factory:implemented", "on": "manual" },
            { "to": "factory:ready", "on": "investigate-result", "outcome": "retry" },
            { "to": "factory:needs-plan", "on": "investigate-result", "outcome": "replan" },
            { "to": "factory:needs-help", "on": "investigate-result", "outcome": "escalate" }
          ],
          "maxDwellHours": 24,
          "onTimeout": "investigate"
        },
        "factory:review": {
          "kind": "automated",
          "lane": "Review",
          "inFlight": true,
          "owner": { "workflow": "factory-review" },
          "exits": [
            { "to": "factory:done", "on": "review-result", "outcome": "approved" },
            { "to": "factory:changes-requested", "on": "review-result", "outcome": "changes" },
            { "to": "factory:investigate", "on": "review-result", "outcome": "limit" }
          ],
          "onConflict": "factory:changes-requested",
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:changes-requested": {
          "kind": "automated",
          "lane": "Active",
          "inFlight": true,
          "owner": { "workflow": "factory-fix-review" },
          "exits": [
            { "to": "factory:working", "on": "start", "outcome": "started" }
          ],
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:investigate": {
          "kind": "automated",
          "lane": "Inbox",
          "owner": { "workflow": "factory-investigate" },
          "exits": [
            { "to": "factory:ready", "on": "investigate-result", "outcome": "retry" },
            { "to": "factory:needs-plan", "on": "investigate-result", "outcome": "replan" },
            { "to": "factory:needs-help", "on": "investigate-result", "outcome": "escalate" }
          ],
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:needs-help": {
          "kind": "human",
          "owner": { "role": "owner" },
          "exits": [
            { "to": "factory:needs-plan", "on": "manual" },
            { "to": "factory:ready", "on": "manual" }
          ],
          "maxDwellHours": 168,
          "onTimeout": "report"
        },
        "factory:human-review": {
          "kind": "human",
          "lane": "Review",
          "owner": { "role": "owner" },
          "exits": [
            { "to": "factory:needs-plan", "on": "manual" }
          ],
          "maxDwellHours": 168,
          "onTimeout": "report"
        },
        "factory:blocked": {
          "kind": "human",
          "owner": { "role": "owner" },
          "exits": [
            { "to": "factory:working", "on": "start", "outcome": "started" },
            { "to": "factory:ready", "on": "lifecycle-sweep" }
          ],
          "onUnblocked": "factory:ready",
          "maxDwellHours": 168,
          "onTimeout": "report"
        },
        "factory:implemented": {
          "kind": "delivery",
          "lane": "Review",
          "owner": { "workflow": "factory-maintenance" },
          "exits": [
            { "to": "factory:pr-open", "on": "delivery-sync" }
          ],
          "maxDwellHours": 72,
          "onTimeout": "report"
        },
        "factory:pr-open": {
          "kind": "delivery",
          "lane": "Review",
          "owner": { "workflow": "factory-maintenance" },
          "exits": [
            { "to": "factory:done", "on": "delivery-sync" }
          ],
          "maxDwellHours": 168,
          "onTimeout": "report"
        },
        "factory:done": {
          "kind": "terminal",
          "lane": "Done"
        }
      }
    },
    "risk-gated": {
      "extends": "standard",
      "description": "The standard process, except that a completed plan for risk:high work waits for a person to sign it off before it can be implemented. Select it with FACTORY_LIFECYCLE_PROFILE=risk-gated, or make it defaultProfile in a project's override of this file.",
      "states": {
        "factory:needs-plan": {
          "kind": "automated",
          "owner": { "workflow": "factory-plan" },
          "exits": [
            { "to": "factory:ready", "on": "plan-result", "outcome": "ready" },
            { "to": "factory:needs-help", "on": "plan-result", "outcome": "not-ready" },
            { "to": "factory:done", "on": "plan-result", "outcome": "decomposed" },
            { "to": "factory:design-signoff", "on": "plan-result", "when": { "risk": ["risk:high"] } }
          ],
          "maxDwellHours": 24,
          "onTimeout": "retrigger"
        },
        "factory:design-signoff": {
          "kind": "human",
          "owner": { "role": "tech-lead" },
          "description": "Factory: plan complete, waiting for a person to sign it off before implementation",
          "exits": [
            { "to": "factory:ready", "on": "manual" },
            { "to": "factory:needs-plan", "on": "manual" }
          ],
          "maxDwellHours": 72,
          "onTimeout": "escalate"
        }
      }
    }
  }
}