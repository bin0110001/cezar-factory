{
  "schemaVersion": 1,
  "description": "Verification workflow policy (workflows/verify.yaml). Mandatory checks run on every verification regardless of what the change touches; they are read from this file, never from agent input. Each id must exist in the project's .ai/factory/test-ownership.json.",
  "mandatoryChecks": [
    "automation-catalog"
  ],
  "checkTimeoutSeconds": 1200,
  "ledger": ".factory/ledger/verification-verdicts.jsonl",
  "stageGates": {
    "pr-dev": {
      "requiredChecks": [
        "automation-catalog"
      ],
      "blockAtOrAbove": "high",
      "maxOutageRetries": 2
    },
    "candidate": {
      "requiredChecks": [
        "automation-catalog"
      ],
      "blockAtOrAbove": "medium",
      "maxOutageRetries": 2
    },
    "stable": {
      "requiredChecks": [
        "automation-catalog"
      ],
      "blockAtOrAbove": "medium",
      "maxOutageRetries": 1
    }
  },
  "protectedPaths": [
    "policies/verification.json",
    "policies/baseline-promotion.json",
    "schemas/verification-policy.schema.json",
    "baselines/*",
    "baselines/**",
    "waivers/*",
    "waivers/**",
    "scripts/release/verification_disposition.py"
  ]
}
