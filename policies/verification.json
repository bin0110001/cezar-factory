{
  "schemaVersion": 1,
  "description": "Verification workflow policy (workflows/verify.yaml). Mandatory checks run on every verification regardless of what the change touches; they are read from this file, never from agent input. Each id must exist in the project's .ai/factory/test-ownership.json.",
  "mandatoryChecks": [
    "automation-catalog"
  ],
  "checkTimeoutSeconds": 1200,
  "ledger": ".factory/ledger/verification-verdicts.jsonl",
  "dispositionRules": {
    "version": "disposition-policy-1",
    "stages": {
      "pr-dev": {
        "requiredChecks": [
          "automation-catalog"
        ],
        "default": {
          "known": "CONTINUE",
          "resolved": "CONTINUE",
          "new": "RECORD",
          "worsened": "RECORD",
          "reopened": "RECORD",
          "untested": "RECORD",
          "unknown": "RECORD",
          "infra-failure": "RETRY"
        },
        "rules": [
          {
            "id": "impacted-regression",
            "when": {
              "decision": [
                "new",
                "worsened",
                "reopened"
              ],
              "impacted": true,
              "minSeverity": "medium"
            },
            "action": "BLOCK",
            "reason": "a regression in the area this change touches"
          }
        ],
        "maxRetries": 2
      },
      "candidate": {
        "requiredChecks": [],
        "default": {
          "known": "CONTINUE",
          "resolved": "CONTINUE",
          "new": "RECORD",
          "worsened": "RECORD",
          "reopened": "RECORD",
          "untested": "RECORD",
          "unknown": "RECORD",
          "infra-failure": "RETRY"
        },
        "rules": [
          {
            "id": "impacted-regression",
            "when": {
              "decision": [
                "new",
                "worsened",
                "reopened"
              ],
              "impacted": true,
              "minSeverity": "medium"
            },
            "action": "BLOCK",
            "reason": "a regression in the impacted area"
          },
          {
            "id": "new-serious-security",
            "when": {
              "decision": [
                "new",
                "worsened",
                "reopened"
              ],
              "class": "security",
              "minSeverity": "high"
            },
            "action": "BLOCK",
            "reason": "a new high or critical security finding"
          }
        ],
        "maxRetries": 2
      },
      "stable": {
        "requiredChecks": [
          "full-suite"
        ],
        "default": {
          "known": "CONTINUE",
          "resolved": "CONTINUE",
          "new": "RECORD",
          "worsened": "RECORD",
          "reopened": "RECORD",
          "untested": "BLOCK",
          "unknown": "BLOCK",
          "infra-failure": "RETRY"
        },
        "rules": [
          {
            "id": "impacted-regression",
            "when": {
              "decision": [
                "new",
                "worsened",
                "reopened"
              ],
              "impacted": true,
              "minSeverity": "low"
            },
            "action": "BLOCK",
            "reason": "any regression in the impacted area"
          },
          {
            "id": "new-serious-security",
            "when": {
              "decision": [
                "new",
                "worsened",
                "reopened"
              ],
              "class": "security",
              "minSeverity": "high"
            },
            "action": "BLOCK",
            "reason": "a new high or critical security finding"
          }
        ],
        "maxRetries": 1
      }
    }
  }
}
