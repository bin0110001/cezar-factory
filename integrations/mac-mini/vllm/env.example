# Native launchd configuration. The deployment script creates the plist.
VLLM_MODEL=mlx-community/Qwen3.5-9B-5bit
VLLM_SERVED_MODEL=qwen3.5-9b
VLLM_VENV=$HOME/.venv-vllm-metal
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=32768
# Enable only when the selected checkpoint and parser have been tested.
VLLM_ENABLE_AUTO_TOOL_CHOICE=false
VLLM_TOOL_CALL_PARSER=qwen3_xml
VLLM_GENERAL_MODEL=mlx-community/gemma-4-E4B-it-qat-4bit
VLLM_GENERAL_SERVED_MODEL=gemma-4
VLLM_GENERAL_HOST=127.0.0.1
VLLM_GENERAL_PORT=8001
VLLM_GENERAL_MAX_MODEL_LEN=4096
# VLLM_API_KEY=REPLACE_ON_HOST (not used by the current native launchd plist)
