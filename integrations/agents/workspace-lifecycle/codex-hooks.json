{
  "description": "Advisory local workspace lifecycle context for external Codex sessions.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cez workspace hook-context --event SessionStart",
            "commandWindows": "cez workspace hook-context --event SessionStart",
            "statusMessage": "Checking workspace ownership",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cez workspace hook-context --event Stop",
            "commandWindows": "cez workspace hook-context --event Stop",
            "statusMessage": "Checking workspace completion",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
