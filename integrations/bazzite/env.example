# Copy to a host-local env file; never commit the filled-in file.
CEZAR_IMAGE=registry.example/cezar:stable
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas:1.24.0
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:0.10.0
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_DB_IMAGE=docker.io/library/postgres:16-alpine
LANGFUSE_IMAGE=langfuse/langfuse:latest
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.4.0
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
# Pin this to a supported Vault release or digest before production use.
VAULT_IMAGE=docker.io/hashicorp/vault:1.20.0
# Host identity, Podman connection, health address, and vLLM networking are
# declared in config/server-topology.env.

CEZAR_AUTOMATIONS=1
CEZ_API_URL=http://cezar:3000
CEZ_PROJECT_ID=
# Host checkout mounted read-only into Cezar/OpenHands for isolated-worktree
# Factory scripts. The host path must contain scripts/audit-backlog-labels.ps1.
FACTORY_RUNTIME_HOST_DIR=/var/home/bin0110001/cezar-factory
FACTORY_RUNTIME_ROOT=/projects/cezar-factory
OPENHANDS_AGENT_SERVER_URL=http://openhands:8000
OPENHANDS_SESSION_API_KEY=change-me-on-host
# Keep loopback by default. Set to 0.0.0.0 only on a trusted LAN when Canvas
# configuration must be reached from another workstation.
OPENHANDS_BIND_ADDRESS=127.0.0.1
HINDSIGHT_URL=http://hindsight:8888
HINDSIGHT_FACTORY_BANK=factory
HINDSIGHT_PROJECT_BANK=project-REPLACE_PROJECT_ID
HINDSIGHT_API_LLM_PROVIDER=openai
# Use the LiteLLM master key here; keep this value only in the host-local .env.
HINDSIGHT_API_LLM_API_KEY=change-me-on-host
HINDSIGHT_API_LLM_BASE_URL=http://litellm:4000/v1
HINDSIGHT_API_LLM_MODEL=factory-small
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=12000
LITELLM_MASTER_KEY=change-me-on-host
LITELLM_SALT_KEY=change-me-on-host
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=change-me-on-host
# URL-encode any reserved characters in the password before placing it here.
LITELLM_DATABASE_URL=postgresql://litellm:change-me-on-host@litellm-db:5432/litellm
# Native vLLM endpoint and its proxy/network policy are supplied by topology.
# vLLM currently ignores this header; LiteLLM's OpenAI-compatible client still requires a non-empty value.
VLLM_API_KEY=sk-local-vllm
LANGFUSE_PUBLIC_KEY=change-me-on-host
LANGFUSE_SECRET_KEY=change-me-on-host
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_OTEL_HOST=http://langfuse:3000
