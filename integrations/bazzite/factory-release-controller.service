[Unit]
Description=Fetch and stage a verified immutable Factory release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/usr/bin/python3 %h/cezar-factory/scripts/release/factory_release_controller.py sync --repo %h/cezar-factory --store %h/.local/share/cezar-factory/release-store --channel stable
TimeoutStartSec=20min
