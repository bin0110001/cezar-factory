# Copy to integrations/bazzite/obot/.env on Bazzite and set local values.
# The file contains a bootstrap secret and must remain mode 0600 and untracked.
OBOT_IMAGE=ghcr.io/obot-platform/obot:v0.27.0@sha256:06b6b506631c2bf20f7ed795ffb12d4f448319754cd1893a58315dc145262da0
OBOT_BIND_ADDRESS=192.168.86.69
OBOT_TLS_HOSTNAME=obot.192.168.86.69.sslip.io
OBOT_HTTPS_PORT=8443
OBOT_SERVER_HOSTNAME=obot.192.168.86.69.sslip.io:8443
OBOT_PUBLIC_URL=https://obot.192.168.86.69.sslip.io:8443
OBOT_HOST_PORT=8787
OBOT_BOOTSTRAP_TOKEN=REPLACE_ON_BAZZITE
OBOT_DATA_VOLUME=cezar-factory-obot-poc-data
OBOT_PROXY_DATA_VOLUME=cezar-factory-obot-poc-proxy-data
OBOT_PROXY_CONFIG_VOLUME=cezar-factory-obot-poc-proxy-config
CADDY_IMAGE=docker.io/library/caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

# Obot's container image and named volume use Podman's configured graphroot.
# The deploy script requires that graphroot to reside on this mounted disk.
OBOT_REQUIRED_PODMAN_STORAGE_MOUNT=/var/mnt/podman
