# Copy to integrations/mcp-gateway/.env (gitignored, owner-only) and fill in the token.
OBOT_MCP_URL=https://obot.192.168.86.69.sslip.io:8443/mcp-connect/<vmcp-id>
# Optional per-project Claude Code endpoint for the separate Hindsight vMCP.
# The committed .mcp.json has the current URL as its default.
OBOT_HINDSIGHT_MCP_URL=https://obot.192.168.86.69.sslip.io:8443/mcp-connect/vmcp1gcv4n
OBOT_MCP_TOKEN=
# Optional: public root cert of the gateway's Caddy internal CA, if the runner host doesn't trust it.
# OBOT_MCP_CA_CERT=/path/to/root.crt
