# Copy to config/server-topology.env and fill in the hosts that belong to this
# installation.  This is inventory, not a secrets file; host-local secrets stay
# in integrations/*/.env and must never be committed.
#
# Service placement is explicit so deployment scripts can reject an accidental
# deployment to the wrong host. Service names are space-delimited.
FACTORY_CONTROL_PLANE_ID=control-plane
FACTORY_CONTROL_PLANE_SSH_TARGET=control-plane
FACTORY_CONTROL_PLANE_ADDRESS=192.0.2.10
FACTORY_CONTROL_PLANE_PODMAN_CONNECTION=control-plane
FACTORY_CONTROL_PLANE_SERVICES="cezar openhands hindsight litellm langfuse prometheus grafana vault node-exporter cadvisor"

FACTORY_MODEL_HOST_ID=model-host
FACTORY_MODEL_HOST_SSH_TARGET=model-host
FACTORY_MODEL_HOST_ADDRESS=192.0.2.20
FACTORY_MODEL_HOST_FACTORY_DIR='$HOME/cezar-factory'
FACTORY_MODEL_HOST_SERVICES="vllm"

# Network relationships derived from the placement above. Use the address that
# is actually routable from the control-plane host (it need not be the address
# used by an operator workstation).
FACTORY_VLLM_BASE_URL=http://192.0.2.20:8000/v1
FACTORY_VLLM_METRICS_TARGET=192.0.2.20:8000
FACTORY_VLLM_ALLOWED_CLIENTS=192.0.2.10/32,127.0.0.1/32
FACTORY_CONTROL_PLANE_HEALTH_BASE_URL=http://192.0.2.10
